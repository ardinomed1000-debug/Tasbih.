<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تەسبیحی ئەلکترۆنی ناوازە</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri&family=Vazirmatn:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-gold: #f3af22;
            --gold-glow: rgba(243, 175, 34, 0.45);
            --bg-dark: #070b0e;
            --glass-bg: rgba(15, 23, 30, 0.65);
            --glass-border: rgba(243, 175, 34, 0.15);
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body { 
            background: url('bg.jpg') no-repeat center center fixed; 
            background-size: 100% auto;
            background-color: var(--bg-dark); 
            color: #ffffff; 
            font-family: 'Vazirmatn', 'Segoe UI', sans-serif; 
            margin: 0; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            min-height: 100vh;
            padding: 20px 15px;
            overflow-x: hidden;
        }

        #splash-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, #0d151c 0%, #030507 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: all 0.9s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .splash-logo {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--primary-gold), #ffe494);
            border-radius: 30px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 46px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 35px var(--gold-glow);
            margin-bottom: 35px;
            animation: floatPremium 3.5s infinite ease-in-out;
        }

        @keyframes floatPremium {
            0% { transform: translateY(0px) scale(1); }
            50% { transform: translateY(-15px) scale(1.03); }
            100% { transform: translateY(0px) scale(1); }
        }

        .developer-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 6px;
        }

        .splash-title {
            font-size: 24px; 
            font-weight: 400; 
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 2px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.5);
            opacity: 0;
            animation: fadeInSimple 1.2s forwards 0.4s;
        }

        .splash-name {
            font-family: 'Vazirmatn', 'Segoe UI', sans-serif;
            font-size: 36px;
            font-weight: 800;
            color: var(--primary-gold);
            letter-spacing: 1px;
            text-shadow: 0 0 30px var(--gold-glow), 0 4px 25px rgba(0,0,0,0.8);
            opacity: 0;
            animation: premiumFadeIn 1.6s cubic-bezier(0.1, 0.8, 0.2, 1) forwards 0.6s;
        }

        @keyframes premiumFadeIn {
            0% { transform: scale(0.95); opacity: 0; filter: blur(6px); }
            100% { transform: scale(1); opacity: 1; filter: blur(0); }
        }

        @keyframes fadeInSimple {
            to { opacity: 1; }
        }

        .container { 
            width: 100%; 
            max-width: 420px; 
            display: flex;
            flex-direction: column;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .mosque-title {
            text-align: center;
            font-size: 26px;
            font-weight: 700;
            color: var(--primary-gold);
            margin-top: 5px;
            margin-bottom: 15px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9), 0 0 20px var(--gold-glow);
        }

        .header-section {
            text-align: center;
            padding: 20px 15px;
            min-height: 110px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            margin-bottom: 20px;
        }

        #current-name {
            font-size: 22px;
            font-weight: 400; 
            color: #ffffff;
            line-height: 1.6;
            font-family: 'Amiri', serif;
            text-shadow: 0 2px 5px rgba(0,0,0,0.5);
        }

        .counter-box {
            position: relative;
            width: 250px;
            height: 250px;
            margin: 15px auto;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .svg-ring {
            position: absolute;
            transform: rotate(-90deg);
            filter: drop-shadow(0 0 8px var(--gold-glow));
        }
        
        .circle-bg {
            fill: none;
            stroke: rgba(255, 255, 255, 0.06);
            stroke-width: 7;
        }
        
        .circle-progress {
            fill: none;
            stroke: var(--primary-gold);
            stroke-width: 7;
            stroke-linecap: round;
            transition: stroke-dashoffset 0.15s ease;
        }
        
        .counter-circle { 
            width: 215px; 
            height: 215px; 
            border-radius: 50%; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            background: radial-gradient(circle at center, rgba(20,32,43,0.9) 0%, rgba(10,16,22,0.95) 100%);
            cursor: pointer;
            z-index: 2;
            box-shadow: inset 0 0 25px rgba(0,0,0,0.8), 0 10px 25px rgba(0,0,0,0.5);
            border: 2px solid rgba(243, 175, 34, 0.25);
            transition: transform 0.1s ease;
        }

        .counter-circle:active {
            transform: scale(0.95);
        }

        #count { 
            font-size: 75px; 
            font-weight: 700; 
            color: var(--primary-gold); 
            font-family: 'Vazirmatn', monospace;
            text-shadow: 0 4px 10px rgba(0,0,0,0.6);
        }

        #percentage {
            position: absolute;
            top: 5px;
            right: 10px;
            background: linear-gradient(135deg, var(--primary-gold), #ffca52);
            color: #000;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            z-index: 3;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .info-bar {
            display: flex;
            justify-content: space-between;
            width: 95%;
            margin: 15px auto 10px auto;
            color: #b0c4d6;
            font-size: 14px;
            font-weight: 400;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
        }

        .list-section {
            margin-top: 10px;
            max-height: 320px;
            overflow-y: auto;
            padding-left: 5px;
        }

        .list-section::-webkit-scrollbar {
            width: 6px;
        }
        
        .list-section::-webkit-scrollbar-track {
            background: #092523;
            border-radius: 10px;
        }
        
        .list-section::-webkit-scrollbar-thumb {
            background: #123e3b;
            border-radius: 10px;
        }
        
        .zikr-btn { 
            width: 100%; 
            padding: 18px; 
            margin: 10px 0; 
            background: var(--glass-bg);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid var(--glass-border);
            border-radius: 16px; 
            color: rgba(255, 255, 255, 0.85); 
            cursor: pointer; 
            text-align: right;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: all 0.25s ease;
        }

        .zikr-details {
            max-width: 78%;
            font-family: 'Amiri', serif;
            font-size: 17px;
            font-weight: 400; 
            line-height: 1.4;
        }

        .zikr-btn.active {
            background: rgba(243, 175, 34, 0.12);
            border-color: var(--primary-gold);
            box-shadow: 0 0 15px rgba(243, 175, 34, 0.25);
            transform: scale(1.01);
            color: #ffffff;
        }

        .zikr-btn .badge {
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255,255,255,0.05);
            color: #c4d1db;
            font-size: 12px;
            font-weight: 400;
            padding: 6px 12px;
            border-radius: 10px;
            white-space: nowrap;
            font-family: 'Vazirmatn', sans-serif;
        }

        .zikr-btn.active .badge {
            background: var(--primary-gold);
            color: #000000;
            font-weight: 700;
            box-shadow: 0 2px 8px var(--gold-glow);
        }

        .bottom-nav {
            display: flex;
            justify-content: space-around;
            padding: 16px 0;
            margin-top: 20px;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 18px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }

        .nav-icon {
            color: #ffffff;
            cursor: pointer;
            font-size: 15px;
            font-weight: 400;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: color 0.2s;
        }
    </style>
</head>
<body>

<div id="splash-screen">
    <div class="splash-logo">📿</div>
    <div class="developer-container">
        <div class="splash-title">گەشەپێدەر</div>
        <div class="splash-name">Omed Mala</div>
    </div>
</div>

<div class="container" id="main-content">
    <div class="mosque-title">مزگەوتی هەواری شار</div>

    <div class="header-section">
        <div id="current-name">أَسْتَغْفِرُ اللَّهَ</div>
    </div>

    <div class="counter-box">
        <div id="percentage">0%</div>
        <svg class="svg-ring" width="250" height="250">
            <circle class="circle-bg" cx="125" cy="125" r="110"></circle>
            <circle class="circle-progress" id="progress-bar" cx="125" cy="125" r="110"></circle>
        </svg>
        <div class="counter-circle" onclick="increment()">
            <div id="count">0</div>
        </div>
    </div>

    <div class="info-bar">
        <div id="rounds">Rounds: 0</div>
        <div id="count-status">Count: 0 / 3</div>
    </div>

    <div class="list-section" id="list"></div>

    <div class="bottom-nav">
        <div class="nav-icon" onclick="resetAll()">🔄 ڕیستکردنەوە</div>
        <div class="nav-icon" onclick="decrement()">➖ کەمکردن</div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            const splash = document.getElementById('splash-screen');
            const content = document.getElementById('main-content');
            splash.style.opacity = '0';
            setTimeout(() => { splash.style.display = 'none'; }, 900);
            content.style.opacity = '1';
            content.style.transform = 'translateY(0)';
        }, 3500);
    });

    const zikrs = [
        {name: "أَسْتَغْفِرُ اللَّهَ، أَسْتَغْفِرُ اللَّهَ، أَسْتَغْفِرُ اللَّهَ", limit: 1},
        {name: "اللَّهُمَّ أَنْتَ السَّلَامُ وَمِنْكَ السَّلَامُ، تَبَارَكْتَ ذَا الْجَلَالِ وَالْإِكْرَامِ", limit: 1},
        {name: "لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ", limit: 1},
        {name: "لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ، لَا إِلَهَ إِلَّا اللَّهُ، وَلَا نَعْبُدُ إِلَّا إِيَّاهُ، لَهُ النِّعْمَةُ وَلَهُ الْفَضْلُ وَلَهُ الثَّنَاءُ الْحَسَنُ", limit: 1},
        {name: "لَا إِلَهَ إِلَّا اللَّهُ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ", limit: 1},
        {name: "اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ، وَلَا يَنْفَعُ ذَا الْجَدِّ مِنْكَ الْجَدُّ", limit: 1},
        {name: "سُبْحَانَ اللَّهِ", limit: 33},
        {name: "الْحَمْدُ لِلَّهِ", limit: 33},
        {name: "اللَّهُ أَكْبَرُ", limit: 33},
        {name: "لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ", limit: 1},
        {name: "اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاء وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ وَلَا يَؤُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ", limit: 1},
        {name: "قُلْ هُوَ اللَّهُ أَحَدٌ ۞ اللَّهُ الصَّمَدُ ۞ لَمْ يَلِدْ وَلَمْ يُولَدْ ۞ وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ", limit: 1},
        {name: "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ ۞ مِن شَرِّ مَا خَلَقَ ۞ مِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ۞ وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ ۞ وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", limit: 1},
        {name: "قُلْ أَعُوذُ بِرَبِّ النَّاسِ ۞ مَلِكِ النَّاسِ ۞ إِلَٰهِ النَّاسِ ۞ مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ ۞ الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ ۞ مِنَ الْجِنَّةِ وَالنَّاسِ", limit: 1}
    ];

    let currentIndex = 0;
    let count = 0;
    let rounds = 0;
    let currentLimit = zikrs[0].limit;

    const radius = 110;
    const circumference = 2 * Math.PI * radius;
    const progressBar = document.getElementById('progress-bar');
    progressBar.style.strokeDasharray = `${circumference} ${circumference}`;

    function renderList() {
        const listDiv = document.getElementById('list');
        listDiv.innerHTML = "";
        zikrs.forEach((z, index) => {
            const activeClass = index === currentIndex ? 'active' : '';
            let activeLimit = z.limit;
            if (index === currentIndex) activeLimit = currentLimit;
            listDiv.innerHTML += `
                <div class="zikr-btn ${activeClass}" onclick="selectZikr(${index})">
                    <div class="zikr-details">${z.name}</div>
                    <span class="badge">${activeLimit} جار</span>
                </div>
            `;
        });
    }

    function selectZikr(index) {
        currentIndex = index;
        count = 0;
        currentLimit = zikrs[index].limit;
        updateUI();
    }

    function increment() {
        count++;
        if (count > currentLimit) {
            goToNext();
        } else if (count === currentLimit) {
            updateUI();
            setTimeout(goToNext, 150);
        } else {
            updateUI();
        }
    }

    function goToNext() {
        count = 0;
        currentIndex++;
        if (currentIndex >= zikrs.length) {
            currentIndex = 0;
            rounds++;
        }
        currentLimit = zikrs[currentIndex].limit;
        updateUI();
    }

    function decrement() {
        if (count > 0) {
            count--;
            updateUI();
        }
    }

    function resetAll() {
        count = 0;
        currentIndex = 0;
        rounds = 0;
        currentLimit = zikrs[0].limit;
        updateUI();
    }

    function updateUI() {
        let currentZikr = zikrs[currentIndex];
        document.getElementById('current-name').innerText = currentZikr.name;
        document.getElementById('count').innerText = count;
        document.getElementById('count-status').innerText = `Count: ${count} / ${currentLimit}`;
        document.getElementById('rounds').innerText = `Rounds: ${rounds}`;
        let pct = (count / currentLimit) * 100;
        document.getElementById('percentage').innerText = `${Math.round(pct)}%`;
        const offset = circumference - (pct / 100) * circumference;
        progressBar.style.strokeDashoffset = offset;
        renderList();
    }

    updateUI();
</script>
</body>
</html>
